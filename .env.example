POSTGRES_DB=taxiaibooks
POSTGRES_USER=taxi_user
POSTGRES_PASSWORD=replace-with-random-development-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=20
JWT_ISSUER=taxiaibooks
JWT_AUDIENCE=taxiaibooks-api
# JSON arrays of approved OAuth client IDs; empty disables provider sign-in.
GOOGLE_CLIENT_IDS=[]
APPLE_CLIENT_IDS=[]
# SMTP uses verified TLS (implicit TLS, usually port 465). No delivery without configuration.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=accounts@example.com
# PASSWORD_RESET_URL=https://your-app.example/reset-password
# SMS provider is intentionally unconfigured; implement/inject SMSDelivery before enabling.

